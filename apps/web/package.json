{
  "name": "@bricomission/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BricoMission mobile-first PWA (Next.js App Router + Tailwind CSS, 11 locales).",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 3100",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --port 3100",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --reporter=verbose",
    "test:e2e": "bash ../../scripts/web/e2e.sh"
  },
  "dependencies": {
    "@bricomission/api-client": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lighthouse": "11.7.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
