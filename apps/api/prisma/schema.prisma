// BricoMission Prisma schema. Domain models arrive with their features.
// The connection URL comes from DATABASE_URL via prisma.config.ts.
// Migrations live in prisma/migrations and are applied with `prisma migrate deploy`
// (api container start, best-effort, and scripts/catalog/ingest.sh).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// One ingested Catalog PDF (feature catalog-rag-ingestion). `sourceName` is the
/// file basename; re-ingesting a file with the same name replaces the document.
model CatalogDocument {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceName     String         @unique @map("source_name")
  catalogName    String         @map("catalog_name")
  contentSha256  String         @map("content_sha256") @db.Char(64)
  embeddingModel String         @map("embedding_model")
  pageCount      Int            @map("page_count")
  skippedPages   Int[]          @default([]) @map("skipped_pages")
  /// `indexed` or `no_text_layer`.
  status         String
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  chunks         CatalogChunk[]

  @@map("catalog_document")
}

/// A page-bounded text chunk of a Catalog document with its embedding
/// (vector(1024) = CATALOG_EMBEDDING_DIMENSIONS, HNSW cosine index in the migration).
model CatalogChunk {
  id         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String                      @map("document_id") @db.Uuid
  document   CatalogDocument             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// 1-based page number in the source PDF.
  pageNumber Int                         @map("page_number")
  chunkIndex Int                         @map("chunk_index")
  text       String
  embedding  Unsupported("vector(1024)")

  @@unique([documentId, pageNumber, chunkIndex])
  @@map("catalog_chunk")
}

/// Lifecycle of a Kitchen Project (feature kitchen-capture-draft adds `draft`,
/// login-gate-claim adds `claimed`; later features add the other states).
enum KitchenProjectStatus {
  draft
  claimed

  @@map("kitchen_project_status")
}

/// A homeowner's Kitchen Project. While `draft` it is anonymous: the browser holds an opaque
/// draft token and only its SHA-256 (32 bytes) is stored. Measurements are whole centimetres
/// (CHECK constraints in the migration). `expiresAt` slides 7 days on every change; the API's
/// DraftCleanupService deletes expired drafts and their stored photos.
/// A claim (login-gate-claim) binds the draft to an Account: `status = claimed`, `ownerSub` =
/// the Keycloak `sub`, `claimedAt` set and `expiresAt` NULL (it never expires). The token hash
/// is kept so a repeated claim is idempotent. A hand-written CHECK ties these columns to `status`.
model KitchenProject {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status         KitchenProjectStatus @default(draft)
  draftTokenHash Bytes?               @unique @map("draft_token_hash")
  ownerSub       String?              @map("owner_sub")
  claimedAt      DateTime?            @map("claimed_at") @db.Timestamptz(3)
  lengthCm       Int?                 @map("length_cm")
  widthCm        Int?                 @map("width_cm")
  heightCm       Int?                 @map("height_cm")
  expiresAt      DateTime?            @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  photos         KitchenPhoto[]
  moodboardItems MoodboardItem[]
  renders        KitchenRender[]
  simulations    Simulation[]
  budgets        Budget[]

  @@index([expiresAt])
  @@index([ownerSub])
  @@map("kitchen_project")
}

/// A normalized kitchen photo: two metadata-free JPEG objects in MinIO (`full`, `thumb`).
/// `width`, `height` and `byteSize` describe `full`. Positions are 0-based and compacted.
model KitchenPhoto {
  id               String          @id @db.Uuid
  kitchenProjectId String          @map("kitchen_project_id") @db.Uuid
  kitchenProject   KitchenProject  @relation(fields: [kitchenProjectId], references: [id], onDelete: Cascade)
  position         Int
  fullKey          String          @map("full_key")
  thumbKey         String          @map("thumb_key")
  width            Int
  height           Int
  byteSize         Int             @map("byte_size")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  renders          KitchenRender[]

  @@index([kitchenProjectId, position])
  @@map("kitchen_photo")
}

enum MoodboardItemSource {
  gallery
  upload

  @@map("moodboard_item_source")
}

/// One Moodboard Item of a Kitchen Project (feature moodboard-selection): either a Style Gallery
/// image (`galleryImageId`, no objects) or an own reference photo (two metadata-free JPEG
/// objects in MinIO, `full` and `thumb`). `width`/`height` describe `full`. A hand-written CHECK
/// in the migration ties the columns to `source`. Positions are 0-based and compacted.
model MoodboardItem {
  id               String              @id @db.Uuid
  kitchenProjectId String              @map("kitchen_project_id") @db.Uuid
  kitchenProject   KitchenProject      @relation(fields: [kitchenProjectId], references: [id], onDelete: Cascade)
  position         Int
  source           MoodboardItemSource
  galleryImageId   String?             @map("gallery_image_id")
  fullKey          String?             @map("full_key")
  thumbKey         String?             @map("thumb_key")
  width            Int
  height           Int
  byteSize         Int?                @map("byte_size")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([kitchenProjectId, galleryImageId])
  @@index([kitchenProjectId, position])
  @@map("moodboard_item")
}

/// Lifecycle of a Render (feature controlnet-render).
enum KitchenRenderStatus {
  queued
  running
  succeeded
  failed

  @@map("kitchen_render_status")
}

/// ControlNet that keeps the room geometry.
enum KitchenRenderMode {
  canny
  depth

  @@map("kitchen_render_mode")
}

/// A Render of a claimed Kitchen Project (feature controlnet-render): SDXL + ControlNet from one
/// Photo and the calculated style of its Simulation (simulations-ux-overhaul). Objects in MinIO: `before` (centre crop of the Photo,
/// the model input), `full` and `thumb` (metadata-free JPEGs; `full` has the size of `before`).
/// `prompt`, `seed` and `gpuJobId` are internal provenance, never returned by a route.
/// Hand-written CHECKs in the migration tie the keys and codes to `status`.
model KitchenRender {
  id               String              @id @db.Uuid
  kitchenProjectId String              @map("kitchen_project_id") @db.Uuid
  kitchenProject   KitchenProject      @relation(fields: [kitchenProjectId], references: [id], onDelete: Cascade)
  photoId          String?             @map("photo_id") @db.Uuid
  photo            KitchenPhoto?       @relation(fields: [photoId], references: [id], onDelete: SetNull)
  simulationId     String              @map("simulation_id") @db.Uuid
  simulation       Simulation          @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  /// 0-based position of the source Photo when the Simulation was created (stays when the Photo is deleted).
  photoPosition    Int                 @default(0) @map("photo_position")
  /// 1 for the first run; `Retry` of a failed Render adds 1.
  attempts         Int                 @default(1)
  /// Vision-model element inventory of `full` (phase C), cached for Budget recomputes. Internal.
  inventory        Json?
  status           KitchenRenderStatus @default(queued)
  mode             KitchenRenderMode
  styleId          String?             @map("style_id")
  prompt           String
  seed             Int
  width            Int
  height           Int
  beforeKey        String              @map("before_key")
  fullKey          String?             @map("full_key")
  thumbKey         String?             @map("thumb_key")
  errorCode        String?             @map("error_code")
  gpuJobId         String?             @map("gpu_job_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt        DateTime?           @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?           @map("finished_at") @db.Timestamptz(3)
  seconds          Float?              @db.Real

  @@index([kitchenProjectId, createdAt])
  @@index([simulationId, photoPosition])
  @@map("kitchen_render")
}

enum SimulationBlendMode {
  ip_adapter
  vlm_text
  both

  @@map("simulation_blend_mode")
}

enum SimulationStage {
  describing
  rendering
  finished

  @@map("simulation_stage")
}

/// A Simulation (feature simulations-ux-overhaul): one Render per Photo, all sharing one calculated
/// style blended from every Moodboard item. `styleSeed` and `styleWeights` are internal provenance
/// (never returned by a route): `styleWeights` is `[{kind, refId, weight}]` (weights sum to 1), null
/// for Simulations migrated from the single-Render model. `ordinal` is per project and never reused.
/// At most one Simulation per project is `selected` (partial unique index in the migration).
/// Hand-written CHECKs: ordinal >= 1, seed >= 0, `selected` only when `finished`.
model Simulation {
  id               String              @id @db.Uuid
  kitchenProjectId String              @map("kitchen_project_id") @db.Uuid
  kitchenProject   KitchenProject      @relation(fields: [kitchenProjectId], references: [id], onDelete: Cascade)
  ordinal          Int
  styleSeed        Int                 @map("style_seed")
  blendMode        SimulationBlendMode @map("blend_mode")
  styleWeights     Json?               @map("style_weights")
  styleText        String              @default("") @map("style_text")
  styleKeywords    Json                @default("[]") @map("style_keywords")
  styleDegraded    Boolean             @default(false) @map("style_degraded")
  stage            SimulationStage     @default(describing)
  selected         Boolean             @default(false)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  renders          KitchenRender[]
  budgets          Budget[]

  @@unique([kitchenProjectId, ordinal])
  @@map("simulation")
}

/// Vision description of one reference image, cached by the SHA-256 of the scaled JPEG and the
/// model id, so "Generate again" needs no GPU work. `traits` is the validated JSON of the model.
model ReferenceStyleTrait {
  imageHash String   @map("image_hash")
  model     String
  traits    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([imageHash, model])
  @@map("reference_style_trait")
}

/// Platform-wide settings (key/value). First key: `style_blend_mode` (admin-only API).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by")

  @@map("platform_setting")
}

enum BudgetStatus {
  queued
  running
  succeeded
  failed

  @@map("budget_status")
}

enum BudgetStage {
  inventory
  pricing

  @@map("budget_stage")
}

enum BudgetTierName {
  luxury
  high
  medium
  low

  @@map("budget_tier_name")
}

/// A Budget of a claimed Kitchen Project (feature budget-tier-computation): four tiers of verified
/// Line Items, all amounts integer cents computed by code (ADR 0002). Pure database rows (no MinIO).
/// `prompt`, token counts and `gpuJobId` are internal, never returned by a route.
/// Hand-written CHECKs in the migration tie the finish time and the error code to `status`.
model Budget {
  id               String           @id @db.Uuid
  kitchenProjectId String           @map("kitchen_project_id") @db.Uuid
  kitchenProject   KitchenProject   @relation(fields: [kitchenProjectId], references: [id], onDelete: Cascade)
  simulationId     String           @map("simulation_id") @db.Uuid
  simulation       Simulation       @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  /// Phase C: inventory reading then pricing, with image progress. Unused by phase B code.
  stage            BudgetStage      @default(pricing)
  progressDone     Int              @default(0) @map("progress_done")
  progressTotal    Int              @default(0) @map("progress_total")
  /// Phase C: tier names were reassigned by total rank after the last attempt (names only).
  relabeled        Boolean          @default(false)
  status           BudgetStatus     @default(queued)
  errorCode        String?          @map("error_code")
  currency         String           @db.Char(3)
  /// VAT rate in basis points (21 % = 2100); catalog prices are VAT-inclusive.
  vatBps           Int              @map("vat_bps")
  attempts         Int              @default(0)
  prompt           String
  promptTokens     Int?             @map("prompt_tokens")
  completionTokens Int?             @map("completion_tokens")
  gpuJobId         String?          @map("gpu_job_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt        DateTime?        @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?        @map("finished_at") @db.Timestamptz(3)
  tiers            BudgetTier[]
  lineItems        BudgetLineItem[]

  @@index([kitchenProjectId, createdAt])
  @@index([simulationId])
  @@map("budget")
}

/// One tier of a succeeded Budget. `totalCents` = sum of its Line Item subtotals; `subtotalCents`
/// is the part before VAT and `vatCents` the VAT part (`subtotal + vat = total`).
model BudgetTier {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  budgetId      String         @map("budget_id") @db.Uuid
  budget        Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  tier          BudgetTierName
  subtotalCents BigInt         @map("subtotal_cents")
  vatCents      BigInt         @map("vat_cents")
  totalCents    BigInt         @map("total_cents")

  @@unique([budgetId, tier])
  @@map("budget_tier")
}

/// A verified Line Item. The citation (catalog name, page, quote) is stored as data: there is no
/// foreign key to `catalog_chunk`, because re-ingesting a Catalog replaces its chunks.
model BudgetLineItem {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  budgetId       String         @map("budget_id") @db.Uuid
  budget         Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  tier           BudgetTierName
  position       Int
  productName    String         @map("product_name")
  sku            String
  catalogName    String         @map("catalog_name")
  pageNumber     Int            @map("page_number")
  sourceQuote    String         @map("source_quote") @db.VarChar(200)
  quotedPrice    String         @map("quoted_price")
  unitPriceCents BigInt         @map("unit_price_cents")
  quantity       String
  quantityH      Int            @map("quantity_h")
  unit           String
  subtotalCents  BigInt         @map("subtotal_cents")

  @@index([budgetId, tier, position])
  @@map("budget_line_item")
}
