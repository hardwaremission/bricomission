{
  "name": "@bricomission/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts",
    "docker-entrypoint.sh"
  ],
  "description": "BricoMission REST API (NestJS + Prisma + OpenAPI).",
  "scripts": {
    "generate": "CHECKPOINT_DISABLE=1 prisma generate",
    "build": "CHECKPOINT_DISABLE=1 prisma generate && tsc -p tsconfig.build.json",
    "lint": "CHECKPOINT_DISABLE=1 prisma generate && eslint . && tsc --noEmit -p tsconfig.json",
    "test": "CHECKPOINT_DISABLE=1 prisma generate && vitest run --reporter=verbose",
    "openapi:export": "CHECKPOINT_DISABLE=1 prisma generate && UPDATE_OPENAPI_SNAPSHOT=1 vitest run test/openapi-snapshot.spec.ts && pnpm --filter @bricomission/api-client generate",
    "start": "node dist/main.js",
    "generate:sample-catalog": "node scripts/generate-sample-catalog.ts ../../infra/catalog/samples",
    "ingest": "node dist/catalog/cli/ingest.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "heic-decode": "2.1.0",
    "jose": "6.2.17",
    "libheif-js": "1.23.5",
    "multer": "2.5.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@bricomission/shared-types": "workspace:*",
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/pdfkit": "0.17.7",
    "@types/supertest": "7.2.1",
    "pdfkit": "0.20.2",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
