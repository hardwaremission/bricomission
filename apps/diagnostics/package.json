{
  "name": "@bricomission/diagnostics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BricoMission diagnostics dashboard: localhost-only desktop web with a live blueprint graph of the architecture, a narrated event log and per-container metrics (English only, no login).",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 3200",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --port 3200",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@xyflow/react": "12.12.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@bricomission/shared-types": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
