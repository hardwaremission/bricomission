<#--
  Code email, HTML part (design "Code Email (HTML 600 wide + plain text)").
  Overrides the keycloak-2fa-email-authenticator template of the same name. Provider data: code,
  ttl (seconds); Keycloak adds user (first name for the greeting). Inline styles with DESIGN.md
  token colors only, Inter with a system-font fallback, no remote images or fonts.
  Logo (feature brand-logo-animation): the wordmark as a data-URI PNG (280x44 rendered, shown
  140x22, opaque white background) with alt text styled 22/28 bold ink for clients that block
  data URIs. The base64 between the bm-email-logo markers is written by
  apps/web/scripts/render-brand-assets.ts; do not edit it by hand.
-->
<#assign bmTtl = ttl?is_number?then(ttl, (ttl!'300')?number)>
<#assign bmMinutes = (bmTtl / 60)?ceiling>
<#assign bmFont = "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">
<!DOCTYPE html>
<html lang="${locale.language}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>${msg("brandName")}</title>
</head>
<body style="margin:0;padding:0;background-color:#FAFAF8;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#FAFAF8;">
  <tr>
    <td align="center" style="padding:24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:552px;background-color:#FFFFFF;border:1px solid #E2E0DA;border-radius:20px;">
        <tr>
          <td style="padding:32px;font-family:${bmFont};color:#182231;">
            <p style="margin:0 0 24px 0;font-size:22px;line-height:28px;font-weight:700;color:#182231;"><#-- bm-email-logo:begin --><img src="data:image/png;base64," alt="BricoMission" width="140" height="22" style="display:block;width:140px;height:22px;border:0;outline:none;text-decoration:none;font-family:${bmFont};font-size:22px;line-height:28px;font-weight:700;color:#182231;"><#-- bm-email-logo:end --></p>
            <p style="margin:0 0 12px 0;font-size:16px;line-height:24px;color:#182231;"><#if (user.firstName)?has_content>${msg("bmEmailGreeting", user.firstName)}<#else>${msg("bmEmailGreetingNoName")}</#if></p>
            <p style="margin:0 0 24px 0;font-size:16px;line-height:24px;color:#182231;">${msg("bmEmailIntro")}</p>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F2F1ED;border-radius:12px;">
              <tr>
                <td align="center" height="72" style="height:72px;font-family:${bmFont};font-size:34px;line-height:40px;font-weight:700;letter-spacing:10px;color:#2968EC;">${code}</td>
              </tr>
            </table>
            <p style="margin:24px 0 24px 0;font-size:14px;line-height:20px;color:#6B6B70;">${msg("bmEmailValidity", bmMinutes)}</p>
            <div style="height:1px;line-height:1px;font-size:1px;background-color:#E2E0DA;">&nbsp;</div>
            <p style="margin:24px 0 0 0;font-size:14px;line-height:20px;color:#6B6B70;">${msg("bmEmailIgnore")}</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
