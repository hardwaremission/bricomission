{
  "realm": "BricoMission",
  "displayName": "BricoMission",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "es",
    "fr",
    "de",
    "it",
    "pt",
    "nl",
    "sv",
    "no",
    "da",
    "fi"
  ],
  "defaultLocale": "en",
  "loginTheme": "bricomission",
  "emailTheme": "bricomission",
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Homeowner (B2C): owns Projects, budgets and dossiers."
      },
      {
        "name": "professional",
        "description": "Professional (B2B) of a Company: bids on published dossiers once validated."
      },
      {
        "name": "admin",
        "description": "Administrator: back-office only, never acts as a Homeowner."
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-bricomission",
        "description": "Default roles: every new account (self-registration) gets realm role user. Imported seeded users get only their listed realmRoles.",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "user"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-bricomission",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "bricomission-api",
      "name": "BricoMission API",
      "description": "Audience of the REST API access tokens. No login flow is enabled.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "bricomission-dev-cli",
      "name": "BricoMission dev CLI",
      "description": "Public client for local development and smoke tests only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost/dev-callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "bricomission-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "bricomission-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "bricomission-web",
      "name": "BricoMission web",
      "description": "Confidential OIDC client of the web PWA server (Backend-for-Frontend). Authorization Code + PKCE; tokens stay on the server.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${BM_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "rootUrl": "${BM_WEB_PUBLIC_URL}",
      "baseUrl": "${BM_WEB_PUBLIC_URL}",
      "redirectUris": [
        "${BM_WEB_PUBLIC_URL}/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${BM_WEB_PUBLIC_URL}/"
      },
      "protocolMappers": [
        {
          "name": "bricomission-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "bricomission-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "bm-admin",
      "email": "admin@bricomission.local",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "realmRoles": [
        "admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${BM_SEED_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "bm-homeowner",
      "email": "homeowner@bricomission.local",
      "emailVerified": true,
      "firstName": "Hugo",
      "lastName": "Homeowner",
      "enabled": true,
      "realmRoles": [
        "user"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${BM_SEED_HOMEOWNER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "bm-professional",
      "email": "professional@bricomission.local",
      "emailVerified": true,
      "firstName": "Paula",
      "lastName": "Professional",
      "enabled": true,
      "realmRoles": [
        "professional"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${BM_SEED_PROFESSIONAL_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@bricomission.local",
    "fromDisplayName": "BricoMission",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "browserFlow": "browser-email-otp",
  "registrationFlow": "registration-email-otp",
  "authenticationFlows": [
    {
      "alias": "browser-email-otp",
      "description": "Browser login: SSO cookie, or password followed by an email one-time code.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "browser-email-otp forms",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-email-otp forms",
      "description": "Username and password, then a 6-digit code sent to the account email.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "email-authenticator-no-enrollment",
          "authenticatorConfig": "email-otp-6-digits",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "registration-email-otp",
      "description": "Self-registration: user profile form, then a 6-digit code sent to the new account email.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "registration-page-form",
          "flowAlias": "registration-email-otp form",
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "email-authenticator-no-enrollment",
          "authenticatorConfig": "email-otp-6-digits",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "registration-email-otp form",
      "description": "Copy of the built-in registration form: user profile creation and password validation.",
      "providerId": "form-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "registration-user-creation",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticator": "registration-password-action",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 50,
          "userSetupAllowed": false
        },
        {
          "authenticator": "registration-recaptcha-action",
          "authenticatorFlow": false,
          "requirement": "DISABLED",
          "priority": 60,
          "userSetupAllowed": false
        },
        {
          "authenticator": "registration-terms-and-conditions",
          "authenticatorFlow": false,
          "requirement": "DISABLED",
          "priority": 70,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "email-otp-6-digits",
      "config": {
        "length": "6",
        "ttl": "300",
        "maxAttempts": "5",
        "emailProviderType": "KEYCLOAK",
        "simulationMode": "false",
        "showMaskedEmailOnOtpForm": "true"
      }
    }
  ]
}
