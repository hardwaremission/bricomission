# BricoMission local environment defaults.
# Copy to .env to override; .env is git-ignored; never commit real secrets.
# Every value below equals the default baked into compose.yaml, so the stack
# also runs with no .env at all.

# PostgreSQL (pgvector) superuser name.
POSTGRES_USER=bricomission
# PostgreSQL superuser password (local development only).
POSTGRES_PASSWORD=bricomission
# Default database created on first volume init.
POSTGRES_DB=bricomission
# Host port for PostgreSQL (bound to 127.0.0.1).
POSTGRES_PORT=5432

# MinIO root user (S3 access key).
MINIO_ROOT_USER=bricomission
# MinIO root password (S3 secret key, at least 8 characters).
MINIO_ROOT_PASSWORD=bricomission-dev-secret
# Host port for the MinIO S3 API (bound to 127.0.0.1).
MINIO_API_PORT=9000
# Host port for the MinIO web console (bound to 127.0.0.1).
MINIO_CONSOLE_PORT=9001

# Host port for the Mailpit web UI (bound to 127.0.0.1).
MAILPIT_UI_PORT=8025
# Host port for the Mailpit SMTP server (bound to 127.0.0.1).
MAILPIT_SMTP_PORT=1025
# Maximum messages Mailpit keeps before pruning the oldest.
MP_MAX_MESSAGES=5000

# Host port for the NestJS API (bound to 127.0.0.1; container listens on 3000).
API_PORT=3000
