# BricoMission local environment defaults.
# Copy to .env to override; .env is git-ignored; never commit real secrets.
# Every value below equals the default baked into compose.yaml, so the stack
# also runs with no .env at all.

# PostgreSQL (pgvector) superuser name.
POSTGRES_USER=bricomission
# PostgreSQL superuser password (local development only).
POSTGRES_PASSWORD=bricomission
# Default database created on first volume init.
POSTGRES_DB=bricomission
# Host port for PostgreSQL (bound to 127.0.0.1).
POSTGRES_PORT=5432

# MinIO root user (S3 access key).
MINIO_ROOT_USER=bricomission
# MinIO root password (S3 secret key, at least 8 characters).
MINIO_ROOT_PASSWORD=bricomission-dev-secret
# Host port for the MinIO S3 API (bound to 127.0.0.1).
MINIO_API_PORT=9000
# Host port for the MinIO web console (bound to 127.0.0.1).
MINIO_CONSOLE_PORT=9001
# Private MinIO bucket for kitchen photos (created by the API on first use).
S3_BUCKET=bricomission-media
# Anonymous kitchen drafts expire this many days after their last change.
DRAFT_TTL_DAYS=7
# How often the API deletes expired drafts and their photos (ms; it also runs on API start).
DRAFT_CLEANUP_INTERVAL_MS=3600000
# Global cap of open anonymous drafts (above it, starting a draft answers 429).
DRAFT_MAX_OPEN=2000

# Host port for the Mailpit web UI (bound to 127.0.0.1).
MAILPIT_UI_PORT=8025
# Host port for the Mailpit SMTP server (bound to 127.0.0.1).
MAILPIT_SMTP_PORT=1025
# Maximum messages Mailpit keeps before pruning the oldest.
MP_MAX_MESSAGES=5000

# Host port for the NestJS API (bound to 127.0.0.1; container listens on 3000).
API_PORT=3000

# Host port for the web PWA (Next.js, bound to 127.0.0.1; container listens on 3000).
# Browser E2E (pnpm test:e2e) and Lighthouse target http://localhost:<port>.
WEB_PORT=3100

# --- Keycloak (realm BricoMission; feature keycloak-realm-roles) ---
# Host port for Keycloak (bound to 127.0.0.1; container listens on 8080). Also part of
# the fixed token issuer http://localhost:<port>/realms/BricoMission.
KEYCLOAK_PORT=8180
# Master-realm bootstrap admin (admin console at http://localhost:<port>/admin; local only).
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=bricomission-kc-admin
# Passwords of the seeded realm accounts, read only when the realm is first imported
# (changing them later needs a realm reset, see AGENTS.md "Identity").
# bm-admin (role admin, admin@bricomission.local).
BM_SEED_ADMIN_PASSWORD=bm-admin-dev
# bm-homeowner (role user, homeowner@bricomission.local).
BM_SEED_HOMEOWNER_PASSWORD=bm-homeowner-dev
# bm-professional (role professional, professional@bricomission.local).
BM_SEED_PROFESSIONAL_PASSWORD=bm-professional-dev

# --- Web sign-in (BFF client bricomission-web; feature homeowner-password-login) ---
# Secret of the confidential client bricomission-web, shared by Keycloak (realm import) and
# the web server. Read by Keycloak only on the first realm import (changing it needs a realm reset).
BM_WEB_CLIENT_SECRET=bm-web-dev-secret
# AES-256-GCM key that encrypts the web session tokens at rest (base64 of 32 bytes).
# Generate your own with: openssl rand -base64 32
# The default is for local development only; changing it signs every web session out.
WEB_SESSION_KEY=SmSKlZZ67zH0iPvgrQkG8MuWdgcXgBOojZ2sFimNMvE=

# --- Local AI (compose profiles "ai" and "ai-fetch"; feature local-ai-gpu-spike) ---
# Host port for llama-server's OpenAI-compatible API (bound to 127.0.0.1).
LLAMA_PORT=8080
# Host port for the ComfyUI API (bound to 127.0.0.1).
COMFYUI_PORT=8188
# MoE layers whose expert tensors stay in system RAM (48 = all layers of Qwen3-30B-A3B).
LLAMA_N_CPU_MOE=48
# llama-server context size in tokens (shared by its 4 slots).
LLAMA_CTX_SIZE=16384
# Host GID of the `render` group (owner of /dev/kfd); check with: getent group render
RENDER_GID=987
# Set to 1 to also fetch the SD 1.5 fallback models in the ai-fetch run.
FETCH_SD15=0

# --- AI layer in the API (feature gpu-job-broker) ---
# AI adapters: fake (deterministic, no GPU calls) or local (LLM via llama-server; image stays fake until controlnet-render).
AI_ADAPTERS=fake
# llama-server base URL as seen from the api container.
LLM_BASE_URL=http://llama-server:8080
# ComfyUI base URL as seen from the api container.
COMFYUI_BASE_URL=http://comfyui:8188
# Set to true to mount the debug POST /ai/jobs (test endpoint; keep false otherwise).
GPU_BROKER_DEBUG_ENDPOINTS=false
# LLM jobs that may share the GPU with each other (never with an image job).
GPU_BROKER_LLM_CONCURRENCY=1
# Queued GPU jobs accepted before new submissions are rejected (debug endpoint: 429).
GPU_BROKER_MAX_QUEUED=20
# Read by the API process but not passed through compose (defaults in code; for `pnpm` runs):
# GPU_BROKER_IMAGE_TIMEOUT_MS=180000, GPU_BROKER_LLM_TIMEOUT_MS=120000, GPU_BROKER_RETENTION_MS=3600000,
# AI_FAKE_IMAGE_DELAY_MS=3000, AI_FAKE_LLM_DELAY_MS=500 (simulated work time of the fake adapters).

# --- Catalog RAG embedder (compose profiles "rag" and "rag-fetch"; feature catalog-rag-ingestion, ADR 0004) ---
# Host port for the CPU embedder's OpenAI-compatible API (bound to 127.0.0.1).
EMBEDDING_PORT=8090
# CPU threads used by the embedder (llama-server -t).
EMBEDDING_THREADS=8
# Embedding model id stored with each Catalog document; changing it makes ingestion re-embed.
EMBEDDING_MODEL=qwen3-embedding-0.6b-q8_0
# Query instruction prefix: leave unset for the Qwen3 default; set it empty (EMBEDDING_QUERY_INSTRUCTION=) for bge-m3.
# EMBEDDING_QUERY_INSTRUCTION=
